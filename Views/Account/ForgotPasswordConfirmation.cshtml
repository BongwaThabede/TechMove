@{
    ViewData["Title"] = "Password Reset";
    Layout = "_LayoutLanding";
}

<div class="card shadow-lg border-0 rounded-4">
    <div class="card-header bg-white border-0 pt-4">
        <div class="text-center">
            <i class="fas fa-envelope fa-3x text-success mb-3"></i>
            <h2 class="mb-0">Check Your Email</h2>
        </div>
    </div>
    <div class="card-body p-4 text-center">
        <p>Please check your email for instructions to reset your password.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-3">
            <i class="fas fa-sign-in-alt me-2"></i>Back to Login
        </a>
    </div>
</div>