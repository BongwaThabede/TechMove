@{
    ViewData["Title"] = "Check your email";
    Layout = "_LayoutLanding";
}

<div class="landing-login-card landing-forgot-card">
    <h2 class="landing-login-title">Check your email</h2>
    <p class="landing-forgot-intro mb-3">
        If an account exists for that address, we would email a secure link to reset your password.
    </p>
    <p class="landing-account-body text-center small text-muted mb-0">
        This demo does not send email. Use your existing sign-in or <a asp-controller="Account" asp-action="Register">create an account</a>.
    </p>
    <p class="landing-forgot-remember mt-3 mb-2">
        <a asp-controller="Account" asp-action="Login">Back to Log In</a>
    </p>
    <p class="landing-forgot-support mb-0">
        Need help? <a class="landing-support-link" href="mailto:support@techmove.com?subject=Password%20reset%20help">Contact Support</a>.
    </p>
</div>
