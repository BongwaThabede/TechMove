@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_LayoutLanding";
}

<div class="landing-login-card landing-forgot-card">
    <h2 class="landing-login-title">Forgot Password?</h2>

    <p class="landing-forgot-intro">
        Enter your registered email address and we'll send you a secure link to reset your password.
    </p>

    <form asp-action="ForgotPassword" method="post" class="landing-login-form landing-forgot-form">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="landing-field mb-0">
            <label asp-for="Email" class="landing-label"></label>
            <input asp-for="Email" type="email" class="form-control landing-input" placeholder="you@company.com" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small d-block"></span>
        </div>
        <button type="submit" class="btn landing-login-btn w-100 landing-forgot-submit">Send Reset Link</button>
    </form>

    <p class="landing-forgot-remember mb-2">
        Remember your password? <a asp-controller="Account" asp-action="Login">Log In</a>
    </p>
    <p class="landing-forgot-support mb-0">
        Need help? <a class="landing-support-link" href="mailto:support@techmove.com?subject=Password%20reset%20help">Contact Support</a>.
    </p>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
