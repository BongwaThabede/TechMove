@model TechMove.Models.Contract
@{
    ViewData["Title"] = "Edit Contract";
    Layout = "_LayoutDashboard";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-warning text-white">
                    <h4><i class="fas fa-edit me-2"></i>Edit Contract</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="SignedAgreementPath" />
                        <input type="hidden" asp-for="SignedAgreementFileName" />
                        <input type="hidden" asp-for="CreatedDate" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ClientId" class="form-label fw-bold"></label>
                                <select asp-for="ClientId" class="form-select" asp-items="ViewBag.ClientId">
                                    <option value="">-- Select Client --</option>
                                </select>
                                <span asp-validation-for="ClientId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ContractNumber" class="form-label fw-bold"></label>
                                <input asp-for="ContractNumber" class="form-control" />
                                <span asp-validation-for="ContractNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label fw-bold"></label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label fw-bold"></label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label fw-bold"></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Draft">Draft</option>
                                    <option value="Active">Active</option>
                                    <option value="OnHold">On Hold</option>
                                    <option value="Expired">Expired</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServiceLevel" class="form-label fw-bold"></label>
                                <select asp-for="ServiceLevel" class="form-select">
                                    <option value="Standard">Standard</option>
                                    <option value="Gold">Gold</option>
                                    <option value="Platinum">Platinum</option>
                                </select>
                                <span asp-validation-for="ServiceLevel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ContractValueUSD" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="ContractValueUSD" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="ContractValueUSD" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ContractValueZAR" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="ContractValueZAR" class="form-control" type="number" step="0.01" readonly style="background-color: #e9ecef;" />
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.SignedAgreementPath))
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-file-pdf me-2"></i>
                                Current agreement: <strong>@Model.SignedAgreementFileName</strong>
                                <a asp-action="DownloadAgreement" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary ms-2">
                                    <i class="fas fa-download me-1"></i>Download
                                </a>
                            </div>
                        }

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}