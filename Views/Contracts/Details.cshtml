@model TechMove.Models.Contract
@{
    ViewData["Title"] = "Contract Details";
    Layout = "_LayoutDashboard";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-file-contract me-2"></i>Contract Details</h4>
                    <span class="badge bg-light text-dark fs-6">@Model.Status</span>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-warning">@TempData["ErrorMessage"]</div>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Contract Number</dt>
                                <dd class="col-sm-8">@Model.ContractNumber</dd>

                                <dt class="col-sm-4">Client</dt>
                                <dd class="col-sm-8">@Model.Client?.Name</dd>

                                <dt class="col-sm-4">Service Level</dt>
                                <dd class="col-sm-8">@Model.ServiceLevel</dd>

                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Status == "Active")
                                    {
                                        <span class="badge bg-success">@Model.Status</span>
                                    }
                                    else if (Model.Status == "Draft")
                                    {
                                        <span class="badge bg-secondary">@Model.Status</span>
                                    }
                                    else if (Model.Status == "Expired")
                                    {
                                        <span class="badge bg-danger">@Model.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">@Model.Status</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Start Date</dt>
                                <dd class="col-sm-8">@Model.StartDate.ToShortDateString()</dd>

                                <dt class="col-sm-4">End Date</dt>
                                <dd class="col-sm-8">@Model.EndDate.ToShortDateString()</dd>

                                <dt class="col-sm-4">Value (USD)</dt>
                                <dd class="col-sm-8">$@Model.ContractValueUSD.ToString("N2")</dd>

                                <dt class="col-sm-4">Value (ZAR)</dt>
                                <dd class="col-sm-8">R @Model.ContractValueZAR.ToString("N2")</dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.SignedAgreementPath))
                    {
                        <div class="alert alert-success mt-3">
                            <i class="fas fa-file-pdf me-2"></i>
                            Signed Agreement: <strong>@Model.SignedAgreementFileName</strong>
                            <a asp-action="DownloadAgreement" asp-route-id="@Model.Id" class="btn btn-sm btn-success ms-3">
                                <i class="fas fa-download me-1"></i>Download PDF
                            </a>
                        </div>
                    }

                    <div class="mt-4">
                        @if (Model.Status == "Active")
                        {
                            <a asp-controller="ServiceRequests" asp-action="Create" asp-route-contractId="@Model.Id" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Raise Service Request
                            </a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fas fa-edit me-2"></i>Edit Contract
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>