@model TechMove.Models.Contract
@{
    ViewData["Title"] = "Create Contract";
}

<h1>Create Contract</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ClientId" class="form-label"></label>
        <select asp-for="ClientId" class="form-select" asp-items="ViewBag.ClientId"></select>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option>Draft</option>
            <option>Active</option>
            <option>Expired</option>
            <option>OnHold</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="ServiceLevel" class="form-label"></label>
        <input asp-for="ServiceLevel" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Signed Agreement (PDF only)</label>
        <input type="file" class="form-control" name="signedAgreement" accept=".pdf" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
