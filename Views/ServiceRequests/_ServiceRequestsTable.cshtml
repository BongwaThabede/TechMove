@model IEnumerable<TechMove.Models.ServiceRequest>

<div class="card">
    <div class="card-body p-0">
        <table class="table data-table mb-0">
            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Contract</th>
                    <th>Description</th>
                    <th>Cost</th>
                    <th>Requested</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td><strong>SR-@request.Id.ToString("D6")</strong></td>
                        <td>
                            @request.Contract?.Client?.Name<br>
                            <small class="text-muted">CTR-@(request.Contract != null ? request.Contract.Id.ToString("D5") : "N/A")</small>
                        </td>
                        <td>@request.Description</td>
                        <td>
                            $@request.Cost.ToString("N0")<br>
                            <small class="text-muted">R@request.CostInZAR.ToString("N0")</small>
                        </td>
                        <td>@(request.RequestDate.ToString("dd MMM yyyy") ?? "N/A")</td>
                        <td>
                            <span class="status-badge @request.Status.ToLower()">
                                @request.Status
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-outline-secondary">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-tasks fa-3x mb-3"></i>
                <p>No service requests found in this category.</p>
            </div>
        }
    </div>
</div>