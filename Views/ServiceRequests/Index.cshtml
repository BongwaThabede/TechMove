@model IEnumerable<TechMove.Models.ServiceRequest>
@{
    ViewData["Title"] = "Service Requests";
    Layout = "_LayoutDashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">Service Requests</h1>
            <p class="text-muted">View and manage all service requests</p>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Request #</th>
                            <th>Client</th>
                            <th>Contract</th>
                            <th>Description</th>
                            <th>Cost (USD)</th>
                            <th>Cost (ZAR)</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Request Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.RequestNumber</strong></td>
                                <td>@item.Contract?.Client?.Name</td>
                                <td>@item.Contract?.ContractNumber</td>
                                <td>@item.Description</td>
                                <td>$@item.Cost.ToString("N2")</td>
                                <td><strong>R @item.CostInZAR.ToString("N2")</strong></td>
                                <td>
                                    @if (item.Priority == "Urgent")
                                    {
                                        <span class="badge bg-danger">@item.Priority</span>
                                    }
                                    else if (item.Priority == "High")
                                    {
                                        <span class="badge bg-warning">@item.Priority</span>
                                    }
                                    else if (item.Priority == "Normal")
                                    {
                                        <span class="badge bg-info">@item.Priority</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Priority</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">@item.Status</span>
                                    }
                                    else if (item.Status == "InProgress")
                                    {
                                        <span class="badge bg-primary">In Progress</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td>@item.RequestDate.ToShortDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h5>No service requests found</h5>
                    <p class="text-muted">No service requests have been created yet.</p>
                </div>
            }
        </div>
    </div>
</div>