@model IEnumerable<TechMove.Models.ServiceRequest>
@{
    ViewData["Title"] = "Service Requests";
}

<h1>Service Requests</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Client</th>
            <th>Contract</th>
            <th>Description</th>
            <th>Status</th>
            <th>Cost (USD)</th>
            <th>Cost (ZAR)</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Contract?.Client?.Name</td>
            <td>#@item.ContractId</td>
            <td>@item.Description</td>
            <td>@item.Status</td>
            <td>@item.Cost</td>
            <td>@item.CostInZAR</td>
        </tr>
    }
    </tbody>
</table>
